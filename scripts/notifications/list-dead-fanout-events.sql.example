-- Example: list durable fanout outbox rows in DEAD status (run against notification DB).
-- Adjust schema/limits for your environment.

SELECT id,
       event_id,
       recipient_user_id,
       event_type,
       status,
       attempt_count,
       last_error,
       created_at,
       sent_at
FROM notification_fanout_outbox
WHERE status = 'DEAD'
ORDER BY created_at DESC
LIMIT 200;
