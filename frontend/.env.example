VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_TRANSPORT=bearer
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_PREFERENCES_ENABLED=true
VITE_WORKSPACE_NOTIFICATION_PREFERENCES_ENABLED=false
VITE_MFA_UI_ENABLED=false

# Admin / audit UI (local dev)
VITE_ADMIN_UI_ENABLED=true
