VITE_AUDIT_API_MODE=mock
VITE_SOURCEMAP=false

# Offline (Faz 67; defaults match production posture)
VITE_OFFLINE_EDIT_ENABLED=false
VITE_OFFLINE_SYNC_ENABLED=false
VITE_OFFLINE_EDIT_MAX_DRAFTS=50
VITE_OFFLINE_EDIT_MAX_DRAFT_AGE_DAYS=7
